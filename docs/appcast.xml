    <item>
      <title>Version 1.3.0</title>
      <sparkle:version>10300</sparkle:version>
      <sparkle:shortVersionString>1.3.0</sparkle:shortVersionString>
      <description><![CDATA[
        <h2>What's New</h2>
        <ul>
          <li>New Library view that tracks every song you've downloaded, across all playlists</li>
          <li>Import your existing music folders into the library</li>
          <li>Automatic duplicate detection, with a review screen to merge duplicates</li>
          <li>Export selected songs to any folder, with a manifest of what was exported</li>
          <li>Export playlists as plain text</li>
          <li>Improved metadata handling and Genius lyrics lookup</li>
          <li>Various UI refinements and bug fixes</li>
        </ul>
      ]]></description>
      <pubDate>Tue, 04 Aug 2026 15:33:54 +0000</pubDate>
      <enclosure
        url="https://github.com/austinlackey/Music-Downloader/releases/download/v1.3.0/Music-Downloader-1.3.0.zip"
