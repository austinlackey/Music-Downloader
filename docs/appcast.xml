    <item>
      <title>Version 1.4.2</title>
      <sparkle:version>10402</sparkle:version>
      <sparkle:shortVersionString>1.4.2</sparkle:shortVersionString>
      <description><![CDATA[
        <h2>What's New</h2>
        <ul>
          <li>Downloads that fail because the bundled YouTube downloader has fallen out of date now say so plainly and offer to check for an update, instead of showing a wall of error text</li>
          <li>Releases now always ship a current, checksum-verified YouTube downloader</li>
        </ul>
      ]]></description>
      <pubDate>Sat, 22 Aug 2026 19:56:27 +0000</pubDate>
      <enclosure
        url="https://github.com/austinlackey/Music-Downloader/releases/download/v1.4.2/Music-Downloader-1.4.2.zip"
